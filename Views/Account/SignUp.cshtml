@model TableTap.Models.SignUpViewModel

@{
	ViewData["Title"] = "Admin Sign Up";
	Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - TableTap</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <header class="d-flex justify-content-between align-items-center border-bottom px-3 py-2">
        <a asp-controller="Home" asp-action="Index"
           class="fw-bold text-dark text-decoration-none">TableTap</a>

        <span class="small">Administrator Access</span>
    </header>

    <main class="container py-5">
        <div class="border p-4 mx-auto" style="max-width: 360px;">
            <h1 class="h5 fw-bold mb-4">Admin Sign Up</h1>

            <form asp-controller="Account" asp-action="SignUp" method="post">
                <div class="mb-3">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" type="password" class="form-control"
                           autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control"
                           autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-outline-dark w-100" disabled>
                    Sign Up
                </button>

                <div asp-validation-summary="ModelOnly"
                     class="text-danger small mt-2"></div>
            </form>

            <div class="mt-3 small">
                <a asp-controller="Account" asp-action="Login">Back to Login</a>
            </div>
        </div>
    </main>
</body>
</html>
